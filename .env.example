# Ale Voice — Environment Configuration
# Copy to .env and fill in real values

# Gnani AI Voice APIs
GNANI_API_KEY_ID=your_gnani_api_key_here

# Provider toggle: set to "true" for mock STT/TTS, "false" for live Gnani
MOCK_PROVIDERS=true

# Database (leave empty for automatic SQLite fallback)
DATABASE_URL=

# App
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# Open-Meteo (no key needed, but configurable harbour coordinates)
MALPE_LAT=13.3496
MALPE_LON=74.7039

# Demo OTP (hardcoded for prototype)
DEMO_OTP=4821

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

